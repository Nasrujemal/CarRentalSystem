@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<section class="hero">
    <div class="hero-video">
        <video autoplay muted loop playsinline>
            <source src="/videos/driving.mp4" type="video/mp4">
        </video>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1>Rent the Journey</h1>
        <p>Unleash the road with premium cars.</p>
        <a href="/Vehicles" class="cta">Find Your Ride</a>
    </div>
</section>

<!-- Highlight Section -->
<section class="highlights">
    <div class="container">
        <div class="highlight-grid">
            <div class="highlight-item" style="background-image: url('/images/vehicles/sports-car.jpg');">
                <div class="highlight-text">
                    <h3>Speed Unleashed</h3>
                    <p>Experience the thrill of high-performance vehicles.</p>
                </div>
            </div>
            <div class="highlight-item" style="background-image: url('/images/vehicles/luxury-suv.jpg');">
                <div class="highlight-text">
                    <h3>Luxury Redefined</h3>
                    <p>Travel in style with unparalleled comfort.</p>
                </div>
            </div>
            <div class="highlight-item" style="background-image: url('/images/vehicles/electric-car.jpg');">
                <div class="highlight-text">
                    <h3>Eco Driven</h3>
                    <p>Rent sustainable rides for a greener future.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Hero Section */
    .hero {
        position: relative;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
    }

    .hero-video video {
        position: absolute;
        top: 50%;
        left: 50%;
        min-width: 100%; 
        min-height: 100%;
        width: 100px; 
        height: 100px;
        transform: translate(-50%, -50%);
        object-fit: cover;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .hero-content {
        position: relative;
        color: #ffffff;
        z-index: 1;
    }

    .hero h1 {
        font-size: 4rem;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 20px;
        text-transform: uppercase;
        font-family:
        inherit;
    }

    .hero p {
        font-size: 1.5rem;
        font-weight: 500;
        margin-bottom: 40px;
        font-family: inherit;
    }

    .cta {
        display: inline-block;
        background: #ff4d4d;
        color: #ffffff;
        padding: 15px 40px;
        font-size: 1.2rem;
        font-weight: 600;
        text-transform: uppercase;
        text-decoration: none;
        border-radius: 5px;
        transition: all 0.4s ease;
    }

        .cta:hover {
            background: #e60000;
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }

    /* Highlight Section */
    .highlights {
        padding: 100px 0;
        background: #ffffff;
    }

    .highlight-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
    }

    .highlight-item {
        position: relative;
        height: 400px;
        background-size: cover;
        background-position: center;
        border-radius: 10px;
        overflow: hidden;
        transition: transform 0.4s ease;
    }

        .highlight-item:hover {
            transform: scale(1.05);
        }

    .highlight-text {
        position: absolute;
        bottom: 20px;
        left: 20px;
        color: #ffffff;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    }

        .highlight-text h3 {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .highlight-text p {
            font-size: 1.2rem;
            font-weight: 500;
        }

</style>