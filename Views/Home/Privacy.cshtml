@{
    ViewData["Title"] = "Privacy Policy";
}



<!-- Main Content -->
<div class="privacy-page">
    <div class="container py-5">
        <div class="glass-card">
            <div class="gradient-border">
                <div class="content-wrapper">
                    <h1 class="main-title">
                        <span class="gradient-text"><i class="fas fa-user-shield me-3"></i>Privacy Policy</span>
                    </h1>
                    <p class="subtitle">Your trust means everything. We're committed to protecting your data.</p>

                    <!-- Privacy Timeline -->
                    <div class="privacy-timeline">
                        <!-- Timeline Item -->
                        <div class="timeline-item">
                            <div class="timeline-icon gradient-bg">
                                <i class="fas fa-database"></i>
                            </div>
                            <div class="timeline-content">
                                <h3>Data Collection</h3>
                                <p>We only collect essential information needed for reservations and improving our services. This includes contact details and payment information processed through secure channels.</p>
                            </div>
                        </div>

                        <!-- Timeline Item -->
                        <div class="timeline-item">
                            <div class="timeline-icon gradient-bg">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="timeline-content">
                                <h3>Security Measures</h3>
                                <p>Utilizing military-grade encryption and regular security audits to ensure your data remains protected against unauthorized access.</p>
                            </div>
                        </div>

                        <!-- Timeline Item -->
                        <div class="timeline-item">
                            <div class="timeline-icon gradient-bg">
                                <i class="fas fa-cookie-bite"></i>
                            </div>
                            <div class="timeline-content">
                                <h3>Cookie Policy</h3>
                                <p>Our controlled use of cookies enhances site functionality. Manage preferences anytime through your browser settings.</p>
                            </div>
                        </div>

                        <!-- Timeline Item -->
                        <div class="timeline-item">
                            <div class="timeline-icon gradient-bg">
                                <i class="fas fa-user-lock"></i>
                            </div>
                            <div class="timeline-content">
                                <h3>Your Rights</h3>
                                <p>Full control over your personal data with options to access, modify, or delete your information through your account dashboard.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Call-to-Action Section -->
                    <div class="cta-section mt-5">
                        <a href="/" class="gradient-btn d-inline-block">
                            <i class="fas fa-arrow-left me-2"></i>Back to Home
                        </a>
                        <a href="mailto:Jamesnasri143@gmail.com" class="outline-btn d-inline-block ms-3">
                            <i class="fas fa-headset me-2"></i>Contact Support
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* General Styles */
    body {
        font-family: 'Poppins', sans-serif;
        margin: 0;
        padding: 0;
    }

    .privacy-page {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        position: relative;
        max-width: 800px;
        margin: 0 auto;
    }

    .gradient-border {
        padding: 3px;
        background: linear-gradient(45deg, #00b4d8, #00ff88);
        border-radius: 25px;
    }

    .content-wrapper {
        padding: 3rem;
        background: white;
        border-radius: 23px;
    }

    .main-title {
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .gradient-text {
        background: linear-gradient(45deg, #00b4d8, #00ff88);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .subtitle {
        font-size: 1.2rem;
        color: #6c757d;
        margin-bottom: 3rem;
        text-align: center;
    }

    /* Privacy Timeline */
    .privacy-timeline {
        position: relative;
        padding-left: 60px;
        margin: 2rem 0;
    }

    .timeline-item {
        position: relative;
        padding: 2rem 0;
        border-left: 2px solid #dee2e6;
    }

    .timeline-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        position: absolute;
        left: -25px;
        top: 2rem;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .gradient-bg {
        background: linear-gradient(45deg, #00b4d8, #00ff88);
    }

    .timeline-content {
        padding: 1.5rem;
        background: rgba(240, 240, 240, 0.3);
        border-radius: 15px;
        margin-left: 2rem;
        transition: all 0.3s ease;
    }

        .timeline-content:hover {
            transform: translateX(10px);
            box-shadow: 0 5px 15px rgba(0, 180, 216, 0.1);
        }

        .timeline-content h3 {
            color: #2d3436;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .timeline-content p {
            color: #636e72;
            line-height: 1.7;
        }

    /* Buttons */
    .cta-section {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .gradient-btn {
        background: linear-gradient(45deg, #00b4d8, #00ff88);
        color: white !important;
        padding: 1rem 2rem;
        border-radius: 30px;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        font-weight: 500;
    }

        .gradient-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 180, 216, 0.3);
        }

    .outline-btn {
        border: 2px solid #00b4d8;
        color: #00b4d8 !important;
        padding: 1rem 2rem;
        border-radius: 30px;
        text-decoration: none;
        transition: all 0.3s ease;
        font-weight: 500;
    }

        .outline-btn:hover {
            background: #00b4d8;
            color: white !important;
            transform: translateY(-2px);
        }


    /* Responsive Design */
    @@media (max-width: 768px) {
        .content-wrapper {
            padding: 1.5rem;
        }

        .privacy-timeline {
            padding-left: 40px;
        }

        .timeline-icon {
            left: -30px;
        }
    }
</style>