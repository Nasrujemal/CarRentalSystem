@model CarRentalSystem.ViewModels.LoginViewModel

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="glass-card">
        <div class="gradient-border">
            <div class="content-wrapper">
                <h3 class="main-title text-center">
                    <span class="gradient-text"><i class="fas fa-sign-in-alt me-2"></i>Login</span>
                </h3>
                <form asp-action="Login" method="post" class="needs-validation" novalidate>
                    <div class="mb-4">
                        <label for="Email" class="form-label fw-bold">Email</label>
                        <input type="email" class="form-control" asp-for="Email" required style="border-radius: 12px;" />
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>
                    <div class="mb-4">
                        <label for="Password" class="form-label fw-bold">Password</label>
                        <input type="password" class="form-control" asp-for="Password" required style="border-radius: 12px;" />
                        <div class="invalid-feedback">Please enter your password.</div>
                    </div>
                    <div class="mb-4 form-check">
                        <input type="checkbox" class="form-check-input" asp-for="RememberMe" style="cursor: pointer;" />
                        <label class="form-check-label" for="RememberMe">Remember Me</label>
                    </div>
                    <button type="submit" class="gradient-btn w-100">
                        <i class="fas fa-arrow-right me-2"></i> Login
                    </button>
                    <div class="text-center mt-3">
                        <a href="/Account/ForgotPassword" class="text-decoration-none" style="color: #00b4d8;">Forgot Password?</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* General Styles */
    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #ebeff9, #f5f7fa);
        margin: 0;
        padding: 0;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        max-width: 400px;
        width: 100%;
    }

    .gradient-border {
        padding: 3px;
        background: linear-gradient(45deg, #00b4d8, #00ff88);
        border-radius: 25px;
    }

    .content-wrapper {
        padding: 2rem;
        background: white;
        border-radius: 23px;
    }

    .main-title {
        font-size: 2rem;
        margin-bottom: 1.5rem;
    }

    .gradient-text {
        background: linear-gradient(45deg, #00b4d8, #00ff88);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .gradient-btn {
        background: linear-gradient(45deg, #00b4d8, #00ff88);
        color: white !important;
        padding: 1rem 2rem;
        border-radius: 30px;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        font-weight: 500;
    }

        .gradient-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 180, 216, 0.3);
        }
</style>